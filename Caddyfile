# Karpathys Platform — Caddy reverse proxy
# Replace {$DOMAIN} with your domain via environment variable DOMAIN.

{$DOMAIN:localhost} {
    # WebSocket upgrade — must match before static routes
    @ws {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @ws {
        reverse_proxy backend:8000
    }

    # API + realtime
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Frontend
    handle {
        reverse_proxy frontend:3000
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format json
    }
}
