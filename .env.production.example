# ============================================================
# Karpathys Platform — Production Environment
# Copy to .env.production and fill in ALL values.
# Never commit this file with real values.
# ============================================================

# --- App ---
APP_ENV=production
APP_VERSION=0.1.0

# REQUIRED: generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database (required) ---
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/karpathys

# Postgres credentials (for docker-compose.prod.yml)
POSTGRES_USER=karpathys
POSTGRES_PASSWORD=
POSTGRES_DB=karpathys

# --- Redis (required) ---
REDIS_URL=redis://:PASSWORD@redis:6379/0
REDIS_PASSWORD=

# --- CORS (required) ---
# JSON array of allowed origins
CORS_ORIGINS=["https://yourdomain.com"]

# --- Frontend (public) ---
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXT_PUBLIC_WS_URL=wss://yourdomain.com
NEXT_PUBLIC_APP_ENV=production

# --- Caddy proxy ---
DOMAIN=yourdomain.com
